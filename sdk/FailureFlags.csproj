<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Company>Gremlin Inc.</Company>
		<Authors>Gremlin Inc.</Authors>
		<Copyright>2025 Gremlin Inc.</Copyright>
		<PackageId>Gremlin.FailureFlags</PackageId>
		<TargetFramework>net5.0</TargetFramework>
		<Title>Gremlin Failure Flags .NET SDK</Title>
		<Description>Gremlin Failure Flags .NET SDK</Description>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputType>Library</OutputType>
		<DisableWinExeOutputInference>true</DisableWinExeOutputInference>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateProgramFile>false</GenerateProgramFile>
	</PropertyGroup>

	<!--
		Single source of truth for the version. The SDK reports it back to Gremlin in the
		failure-flags-sdk-version label, so the VERSION file and the assembly must not drift.
		Source revision is excluded because it would land in the label as "1.1.0+<sha>".
	-->
	<PropertyGroup>
		<_VersionFromFile>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION'))</_VersionFromFile>
		<Version>$(_VersionFromFile.Trim())</Version>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Abstractions only. A library has no business dragging a console logging implementation
			into every consumer's dependency graph; the example app takes the full package instead.
		-->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
