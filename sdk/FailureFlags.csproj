<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Company>Gremlin Inc.</Company>
		<Authors>Gremlin Inc.</Authors>
		<Copyright>2025 Gremlin Inc.</Copyright>
		<PackageId>Gremlin.FailureFlags</PackageId>
		<!-- 2.0.0: net5.0 support (the only target of the published 1.0.0) is dropped in favor of
		     net48/net8.0/net9.0/net10.0, a breaking change for existing net5.0 consumers. -->
		<Version>2.0.0</Version>
		<TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
		<Title>Gremlin Failure Flags .NET SDK</Title>
		<Description>Gremlin Failure Flags .NET SDK</Description>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputType>Library</OutputType>
		<DisableWinExeOutputInference>true</DisableWinExeOutputInference>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<GenerateProgramFile>false</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
	</ItemGroup>

	<!-- net8.0+ gets System.Text.Json / System.Net.Http.Json from the shared framework;
	     net48 needs them as explicit NuGet references. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Text.Json" Version="10.0.11" />
		<PackageReference Include="System.Net.Http.Json" Version="10.0.11" />
	</ItemGroup>

	<!-- Enables `dotnet build`/`dotnet publish` for the net48 leg without a Windows SDK/Mono install. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
			<PrivateAssets>All</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!-- net48 defaults to C# 7.3; nullable annotations require 8.0+. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

</Project>
